#
# KICKPI-K7 (RK3576) board (out-of-tree vendor board)
#
config ARCH_BOARD_KICKPI_K7
	bool
	default y

if ARCH_BOARD_KICKPI_K7

config KICKPI_K7_LITCORE_CPU_FREQ
	int "LITTLE-core CPU boot frequency (MHz)"
	default 1800
	range 96 2400
	---help---
		Boot-time LITTLE-core (litcore) CPU frequency, in MHz.  Applied once
		during board_late_initialize() via rk3576_clk_set_litcore_cpufreq()
		after the clock tree is initialized.  Only the standard RK3576 LPLL
		gears are accepted (96, 216, 312, 408, 600, 816, 1008, 1200, 1320,
		1392, 1416, 1440, 1464, 1488, 1512, 1536, 1560, 1584, 1608, 1704,
		1800, 1896, 1992, 2016, 2040, 2088, 2184, 2208, 2304, 2400); any
		other value is rejected at runtime and the bootloader-configured
		rate is kept.
		This is a one-shot setting (no DVFS) and affects the LIT core only;
		the big-core cluster (BPLL) has its own path.

		Set to 0 to skip the frequency change entirely and keep the
		bootloader-configured CPU rate.

config KICKPI_K7_AUDIO
	bool "On-board ES8388 audio (SAI1 + I2C3)"
	default n
	depends on RK3576_SAI && RK3576_I2C
	select AUDIO_ES8388
	select AUDIO_FORMAT_PCM
	---help---
		Register the on-board Everest ES8388 codec (I2C3 @ 0x10) driven by
		the SAI1 I2S controller as the PCM audio device /dev/audio/pcm0.
		Muxes the SAI1 MCLK/SCLK/LRCK/SDO0/SDI0 pins at boot.

config KICKPI_K7_STORAGE_AUTOMOUNT
	bool "Automatic removable and on-board storage mounting"
	default y
	depends on FS_FAT && FS_TMPFS && GPT_PARTITION
	depends on SCHED_WORKQUEUE && SCHED_LPWORK
	depends on RK3576_SDMMC || RK3576_EMMC
	---help---
		Discover supported FAT data volumes without formatting media.  Prefer
		a usable eMMC data volume for /data, fall back to SD, and handle SD
		card insertion and removal.  /tmp remains a safe tmpfs; persistent
		temporary storage is published as /tmp/persist when /data is mounted.

endif # ARCH_BOARD_KICKPI_K7

#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config ARCH_CHIP_RK3576
	bool
	default y
	select ARCH_CORTEX_A53
	select ARCH_HAVE_ADDRENV
	select ARCH_HAVE_RESET
	select ARCH_NEED_ADDRENV_MAPPING
	select ARM64_HAVE_PSCI
	select ARCH_HAVE_IRQPRIO

if ARCH_CHIP_RK3576

menu "Rockchip RK3576 Peripheral Selection"

config RK3576_UART
	bool "UART serial"
	default y
	# select UART0_SERIALDRIVER triggers Kconfig-uart which provides
	# CONFIG_UART0_BAUD / CONFIG_UART0_BITS / …  — do NOT remove.
	select UART0_SERIALDRIVER
	# serial ports other than UART0 are configured dynamically
	# not by CONFIG_UARTn_xxx

	select ARCH_HAVE_SERIAL_TERMIOS
	---help---
		Select to enable support for UART.

config RK3576_SDMMC
	bool "SD/MMC (SDMMC0 - SD card)"
	default n
	select ARCH_HAVE_SDIO
	select MMCSD
	select MMCSD_SDIO
	select SDIO_DMA
	select ARCH_HAVE_SDIO_PREFLIGHT
	select SDIO_BLOCKSETUP
	---help---
		Enable the RK3576 SDMMC (SD card) host controller driver
		(Synopsys DesignWare MSHC, PIO + IDMAC internal DMA).

config RK3576_PWM
	bool "PWM (Rockchip PWM v4)"
	default n
	select PWM
	---help---
		Enable the RK3576 PWM driver (Rockchip PWM v4, PWM1 @ 2add0000, 6
		channels).  Continuous-mode output for servo/fan/LED control; the
		counting clock is the 24 MHz oscillator scaled to 12 MHz.  The
		board mux the output pin and registers /dev/pwmN.

config RK3576_EMMC
	bool "eMMC (dwcmshc / SDHCI)"
	default n
	select ARCH_HAVE_SDIO
	select MMCSD
	select MMCSD_SDIO
	select ARCH_HAVE_SDIO_PREFLIGHT
	select SDIO_BLOCKSETUP
	---help---
		Enable the RK3576 eMMC host controller driver (mmc@2a330000, a
		Synopsys dwcmshc / SDHCI 3.0 host -- a different IP from the
		SDMMC/SDIO dw-mshc hosts).  PIO data path, default/high-speed,
		1/4/8-bit bus.  HS400/CQE/DLL are not supported.  The bootloader
		leaves the eMMC CRU clock ungated, so no CRU/pinctrl setup is
		needed (non-removable, loader-configured).

config RK3576_GPIO
	bool "GPIO"
	default n
	select ARCH_HAVE_GPIO_IRQ
	---help---
		Select to enable support for the RK3576 GPIO controller.
		The RK3576 has 5 GPIO banks (GPIO0-GPIO4) with 32 pins each.

config RK3576_I2C
	bool "I2C master"
	default n
	select I2C
	---help---
		Enable the RK3576 I2C master driver (Rockchip RK I2C block,
		polled).  All ten I2C controllers (I2C0..I2C9) are supported;
		the driver is data-driven at runtime -- a per-controller config
		option is unnecessary on this platform.  The controller clock is
		brought up via the CRU; SCL/SDA pin muxing is the board's
		responsibility.

config RK3576_USB
	bool "RK3576 USB OTG0 controller (DWC3)"
	default n
	select USBDEV
	---help---
		Enable the RK3576 USB OTG0 controller driver (Synopsys DWC3 at
		0x23000000).  The controller is dual-role (OTG); this driver
		implements the device (peripheral/gadget) role, USB 2.0
		high-speed, for CDC/ACM and ADB gadget use cases.  The host
		(xHCI) role can be added alongside.

endmenu # Rockchip RK3576 Peripheral Selection

endif # ARCH_CHIP_RK3576

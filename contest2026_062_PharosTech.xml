<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <!-- Track the fork development branch containing reviewed eMMC support. -->
  <remote name="beaconcat" fetch="https://github.com/BeaconCat/"/>
  <extend-project name="nuttx" remote="beaconcat"
                  revision="refs/heads/dev-ai-contest-2026"/>

  <project path="contest2026_062_PharosTech" name="contest2026_062_PharosTech">
    <linkfile src="boards" dest="vendor/rockchip/boards"/>
    <linkfile src="chips" dest="vendor/rockchip/chips"/>
    <linkfile src="app/k7flash" dest="apps/examples/k7flash"/>
    <linkfile src="app/audioctl" dest="apps/system/audioctl"/>
  </project>
</manifest>

+/****************************************************************************
+ * Name: nxplayer_getstate
+ ****************************************************************************/
+
+int nxplayer_getstate(FAR struct nxplayer_s *pplayer)
+{
+  int state;
+
+  if (pplayer == NULL)
+    {
+      return -EINVAL;
+    }
+
+  pthread_mutex_lock(&pplayer->mutex);
+  state = pplayer->state;
+  pthread_mutex_unlock(&pplayer->mutex);
+  return state;
+}
+
+/****************************************************************************
+ * Name: nxplayer_playpcmfd
+ ****************************************************************************/
+
+int nxplayer_playpcmfd(FAR struct nxplayer_s *pplayer, int fd,
+                        uint8_t channels, uint8_t bits, uint32_t rate)
+{
+  static const struct nxplayer_dec_ops_s pcm_ops =
+    {
+      AUDIO_FMT_PCM, NULL, nxplayer_fill_common
+    };
+  int ret;
+
+  if (pplayer == NULL || fd < 0 || channels == 0 || bits == 0 || rate == 0)
+    {
+      return -EINVAL;
+    }
+
+  if (pplayer->state != NXPLAYER_STATE_IDLE)
+    {
+      return -EBUSY;
+    }
+
+  nxplayer_jointhread(pplayer);
+  pplayer->fd = fd;
+  pplayer->ops = &pcm_ops;
+  ret = nxplayer_playinternal(pplayer, AUDIO_FMT_PCM, AUDIO_FMT_UNDEF,
+                              channels, bits, rate, 0);
+  if (ret < 0)
+    {
+      pplayer->fd = -1;
+      pplayer->ops = NULL;
+    }
+
+  return ret;
+}
 

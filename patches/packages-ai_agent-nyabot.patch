+    char *response_body, size_t response_capacity,
+    struct vela_http_response_s *response, vela_http_event_t event,
+    void *event_context);
+static int vela_tls_fixture_read(void *context, void *buffer, size_t size)
+{
+    return recv(*(int *)context, buffer, size, 0);
+}

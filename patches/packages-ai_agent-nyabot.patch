+
+#include "infra/http_response.h"
+#include "infra/vela_tls.h"
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+struct vela_http_input_s {
+    vela_http_reader_t read;
+    void *context;
+    unsigned char buffer[1024];
+    size_t position;
+    size_t length;
+};
+
+static int vela_http_byte(struct vela_http_input_s *input, unsigned char *byte);
+static int vela_http_line(struct vela_http_input_s *input, char *line,
+    size_t capacity, size_t *budget);
+static int vela_http_number(const char *text, unsigned int base, size_t *value);
+static int vela_http_append(struct vela_http_input_s *input, size_t count,
+    char *body, size_t capacity, struct vela_http_response_s *response,
+    vela_http_event_t event, void *event_context);
+
+static int vela_http_byte(struct vela_http_input_s *input, unsigned char *byte)
+{
+    if (input->position == input->length) {
+        int ret = input->read(input->context, input->buffer,
+            sizeof(input->buffer));
+        if (ret <= 0)
+            return VELA_TLS_ERR_READ;
+        if ((size_t)ret > sizeof(input->buffer))
+            return VELA_TLS_ERR_READ;
+        input->position = 0;
+        input->length = (size_t)ret;
+    }
+    *byte = input->buffer[input->position++];
+    return 0;
+}
+
+static int vela_http_line(struct vela_http_input_s *input, char *line,
+    size_t capacity, size_t *budget)
+{
+    size_t length = 0;
+    unsigned char byte;
+    while (*budget > 0) {
+        (*budget)--;
+        if (vela_http_byte(input, &byte) < 0)
+            return VELA_TLS_ERR_READ;
+        if (byte == '\r') {
+            if (*budget == 0)
+                return VELA_TLS_ERR_OVERFLOW;
+            (*budget)--;
+            if (vela_http_byte(input, &byte) < 0 || byte != '\n')
+                return VELA_TLS_ERR_READ;
+            line[length] = 0;
+            return 0;
+        }
+        if ((byte < 32 && byte != '\t') || byte == 127)
+            return VELA_TLS_ERR_READ;
+        if (length + 1 >= capacity)
+            return VELA_TLS_ERR_OVERFLOW;
+        line[length++] = (char)byte;
+    }
+    return VELA_TLS_ERR_OVERFLOW;
+}
+
+static int vela_http_number(const char *text, unsigned int base, size_t *value)
+{
+    size_t result = 0;
+    if (!*text)
+        return VELA_TLS_ERR_READ;
+    for (; *text; text++) {
+        unsigned int digit;
+        if (*text >= '0' && *text <= '9') digit = *text - '0';
+        else if (*text >= 'a' && *text <= 'f') digit = *text - 'a' + 10;
+        else if (*text >= 'A' && *text <= 'F') digit = *text - 'A' + 10;
+        else return VELA_TLS_ERR_READ;
+        if (digit >= base || result > (SIZE_MAX - digit) / base)
+            return VELA_TLS_ERR_READ;
+        result = result * base + digit;
+    }
+    *value = result;
+    return 0;
+}
+
+static int vela_http_append(struct vela_http_input_s *input, size_t count,
+    char *body, size_t capacity, struct vela_http_response_s *response,
+    vela_http_event_t event, void *event_context)
+{
+    if (count >= capacity - response->body_length)
+        return VELA_TLS_ERR_OVERFLOW;
+    while (count > 0) {
+        unsigned char byte;
+        if (vela_http_byte(input, &byte) < 0)
+            return VELA_TLS_ERR_READ;
+        body[response->body_length++] = (char)byte;
+        body[response->body_length] = 0;
+        count--;
+        if (event && byte == '\n') {
+            int ret = event(event_context, body, response->body_length);
+            if (ret != 0)
+                return ret > 0 ? 1 : VELA_TLS_ERR_READ;
+        }
+    }
+    return 0;
+}
+
+int vela_http_response_read(vela_http_reader_t reader, void *context,
+    char *body, size_t capacity, struct vela_http_response_s *response,
+    vela_http_event_t event, void *event_context)
+{
+    struct vela_http_input_s input = { .read = reader, .context = context };
+    char line[1024];
+    size_t budget = VELA_TLS_HDR_BUF;
+    size_t content_length = 0;
+    bool have_length = false;
+    bool chunked = false;
+    int ret;
+    int status;
+    if (!reader || !body || !capacity || !response)
+        return VELA_TLS_ERR_READ;
+    body[0] = 0;
+    memset(response, 0, sizeof(*response));
+    ret = vela_http_line(&input, line, sizeof(line), &budget);
+    if (ret < 0)
+        return ret;
+    if (strlen(line) < 12 ||
+        (strncmp(line, "HTTP/1.1 ", 9) && strncmp(line, "HTTP/1.0 ", 9)) ||
+        line[9] < '2' || line[9] > '5' ||
+        line[10] < '0' || line[10] > '9' ||
+        line[11] < '0' || line[11] > '9' ||
+        (line[12] && line[12] != ' '))
+        return VELA_TLS_ERR_READ;
+    status = (line[9] - '0') * 100 + (line[10] - '0') * 10 + line[11] - '0';
+    for (;;) {
+        ret = vela_http_line(&input, line, sizeof(line), &budget);
+        if (ret < 0)
+            return ret;
+        if (!line[0])
+            break;
+        char *colon = strchr(line, ':');
+        if (!colon || colon == line)
+            return VELA_TLS_ERR_READ;
+        *colon++ = 0;
+        for (char *p = line; *p; p++)
+            if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+                  (*p >= '0' && *p <= '9') || strchr("!#$%&'*+-.^_`|~", *p)))
+                return VELA_TLS_ERR_READ;
+        while (*colon == ' ' || *colon == '\t') colon++;
+        size_t length = strlen(colon);
+        while (length && (colon[length - 1] == ' ' || colon[length - 1] == '\t'))
+            colon[--length] = 0;
+        if (!strcasecmp(line, "Content-Length")) {
+            if (have_length || vela_http_number(colon, 10, &content_length) < 0)
+                return VELA_TLS_ERR_READ;
+            have_length = true;
+        } else if (!strcasecmp(line, "Transfer-Encoding")) {
+            if (chunked || strcasecmp(colon, "chunked"))
+                return VELA_TLS_ERR_READ;
+            chunked = true;
+        } else if (!strcasecmp(line, "Content-Type")) {
+            if (response->content_type[0] || !length ||
+                length >= sizeof(response->content_type))
+                return VELA_TLS_ERR_READ;
+            memcpy(response->content_type, colon, length + 1);
+        } else if (!strcasecmp(line, "Mcp-Session-Id")) {
+            if (response->session_id[0] || !length ||
+                length >= sizeof(response->session_id))
+                return VELA_TLS_ERR_READ;
+            for (size_t i = 0; i < length; i++)
+                if ((unsigned char)colon[i] < 33 || (unsigned char)colon[i] > 126)
+                    return VELA_TLS_ERR_READ;
+            memcpy(response->session_id, colon, length + 1);
+        } else if (!strcasecmp(line, "Content-Encoding") &&
+                   strcasecmp(colon, "identity")) {
+            return VELA_TLS_ERR_READ;
+        }
+    }
+    if (chunked && have_length)
+        return VELA_TLS_ERR_READ;
+    if (status == 204 || status == 304)
+        return (chunked || (have_length && content_length)) ? VELA_TLS_ERR_READ : status;
+    if (strncasecmp(response->content_type, "text/event-stream", 17) ||
+        (response->content_type[17] && response->content_type[17] != ';'))
+        event = NULL;
+    if (chunked) {
+        for (;;) {
+            size_t chunk;
+            budget = sizeof(line);
+            ret = vela_http_line(&input, line, sizeof(line), &budget);
+            if (ret < 0)
+                return ret;
+            char *extension = strchr(line, ';');
+            if (extension) *extension = 0;
+            if (vela_http_number(line, 16, &chunk) < 0)
+                return VELA_TLS_ERR_READ;
+            if (!chunk) {
+                budget = VELA_TLS_HDR_BUF;
+                do {
+                    ret = vela_http_line(&input, line, sizeof(line), &budget);
+                    if (ret < 0) return ret;
+                    /* Trailers cannot change framing or authentication. */
+                } while (line[0]);
+                return status;
+            }
+            ret = vela_http_append(&input, chunk, body, capacity, response,
+                event, event_context);
+            if (ret != 0) return ret > 0 ? status : ret;
+            budget = 2;
+            ret = vela_http_line(&input, line, sizeof(line), &budget);
+            if (ret < 0 || line[0]) return VELA_TLS_ERR_READ;
+        }
+    }
+    if (have_length) {
+        ret = vela_http_append(&input, content_length, body, capacity, response,
+            event, event_context);
+        return ret < 0 ? ret : status;
+    }
+    /* Close-delimited responses need a clean EOF, never a timeout. */
+    for (;;) {
+        if (input.position == input.length) {
+            ret = reader(context, input.buffer, sizeof(input.buffer));
+            if (ret == 0) return status;
+            if (ret < 0 || (size_t)ret > sizeof(input.buffer))
+                return VELA_TLS_ERR_READ;
+            input.position = 0;
+            input.length = (size_t)ret;
+        }
+        ret = vela_http_append(&input, input.length - input.position,
+            body, capacity, response, event, event_context);
+        if (ret != 0) return ret > 0 ? status : ret;
+    }
+}

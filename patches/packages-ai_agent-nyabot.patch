+    return ret < 0 ? VELA_TLS_ERR_READ : ret;
+}
+
+static bool vela_tls_once_field(const char *value, bool token)
+{
+    if (!value || !*value)
+        return false;
+    for (const unsigned char *p = (const unsigned char *)value; *p; p++) {
+        if (*p < 32 || *p > 126 || (token && *p == ' '))
+            return false;
+    }
+    return true;

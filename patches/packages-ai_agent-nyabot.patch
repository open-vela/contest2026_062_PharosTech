+int vela_https_get_once(const char *host, const char *port,
+    const char *path, const vela_header_t *headers, char *response_body,
+    size_t response_capacity, struct vela_http_response_s *response)
+{
+    return vela_https_method_once("GET", host, port, path, headers, "",
+        response_body, response_capacity, response, NULL, NULL);
+}
+
+static int vela_https_method_once(const char *method, const char *host,
+    const char *port, const char *path, const vela_header_t *headers,
+    const char *body, char *response_body, size_t response_capacity,
+    struct vela_http_response_s *response, vela_http_event_t event,
+    void *event_context)
+{
+    int ret;
+    if (!response_body || !response_capacity || !response)
+        return VELA_TLS_ERR_READ;
+    response_body[0] = 0;
+    memset(response, 0, sizeof(*response));
+    if (!method || (strcmp(method, "POST") && strcmp(method, "GET")) ||
+        !vela_tls_once_field(host, true) ||
+        !vela_tls_once_field(port, true) ||
+        !vela_tls_once_field(path, true) || path[0] != '/' || !body ||
+        strlen(host) > 253 || strlen(port) > 5 || strlen(path) > 1024)
+        return VELA_TLS_ERR_WRITE;
+    for (const char *p = port; *p; p++)
+        if (*p < '0' || *p > '9') return VELA_TLS_ERR_WRITE;
+    if (atoi(port) < 1 || atoi(port) > 65535)
+        return VELA_TLS_ERR_WRITE;
+    if (headers) {
+        size_t count = 0;
+        for (const vela_header_t *h = headers; h->name; h++) {
+            if (++count > 24 || !vela_tls_once_field(h->name, true) ||
+                !vela_tls_once_field(h->value, false) ||
+                strlen(h->name) > 64 || strlen(h->value) > 1024 ||
+                !strcasecmp(h->name, "Host") ||
+                !strcasecmp(h->name, "Connection") ||
+                !strcasecmp(h->name, "Content-Length") ||
+                !strcasecmp(h->name, "Transfer-Encoding"))
+                return VELA_TLS_ERR_WRITE;
+            for (const char *p = h->name; *p; p++)
+                if (!((*p >= 'A' && *p <= 'Z') ||
+                      (*p >= 'a' && *p <= 'z') ||
+                      (*p >= '0' && *p <= '9') || *p == '-'))
+                    return VELA_TLS_ERR_WRITE;
+        }
+    }
+    /* Keep the TLS context off constrained agent thread stacks. */
+    tls_ctx_t *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx)
+        return VELA_TLS_ERR_OVERFLOW;
+    ret = tls_ctx_connect(ctx, host, port);
+    if (ret == 0) {
+        char authority[261];
+        if (!strcmp(port, "443")) snprintf(authority, sizeof(authority), "%s", host);
+        else snprintf(authority, sizeof(authority), "%s:%s", host, port);
+        ret = tls_write_request(ctx, method, authority, path, headers,
+            body, strlen(body));
+        if (ret == 0)
+            ret = vela_http_response_read(vela_tls_once_read, ctx,
+                response_body, response_capacity, response, event,
+                event_context);
+    }
+    tls_ctx_free(ctx);
+    free(ctx);
+    return ret;
+}

+        response_body, response_capacity, response, event, event_context);
+}
+
+int vela_http_loopback_get_once(const char *port, const char *path,
+    const vela_header_t *headers, char *response_body,
+    size_t response_capacity, struct vela_http_response_s *response)
+{
+    return vela_tls_fixture_request("GET", port, path, headers, "",

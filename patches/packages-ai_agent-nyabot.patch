+
+static int vela_tls_once_read(void *context, void *buffer, size_t size)
+{
+    tls_ctx_t *ctx = context;
+    int ret = mbedtls_ssl_read(&ctx->ssl, buffer, size);
+    if (ret == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY)
+        return 0;

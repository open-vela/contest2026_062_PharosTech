+}
+
+static int vela_tls_fixture_request(const char *method, const char *port,
+    const char *path, const vela_header_t *headers, const char *body,
+    char *response_body, size_t response_capacity,
+    struct vela_http_response_s *response, vela_http_event_t event,
+    void *event_context)
+{
+    struct addrinfo hints = { .ai_family = AF_INET,
+        .ai_socktype = SOCK_STREAM, .ai_flags = AI_NUMERICHOST };
+    struct addrinfo *address = NULL;
+    char *request = NULL;
+    int fd = -1;
+    int ret = VELA_TLS_ERR_WRITE;
+    if (!method || (strcmp(method, "POST") && strcmp(method, "GET")) ||
+        !vela_tls_once_field(port, true) || !vela_tls_once_field(path, true) ||
+        path[0] != '/' || strlen(path) > 1024 || strlen(port) > 5 || !body ||
+        !response_body || !response_capacity || !response)
+        return ret;
+    response_body[0] = 0;
+    memset(response, 0, sizeof(*response));
+    for (const char *p = port; *p; p++)
+        if (*p < '0' || *p > '9') return ret;
+    if (atoi(port) < 1 || atoi(port) > 65535) return ret;
+    request = malloc(4096);
+    if (!request) return VELA_TLS_ERR_OVERFLOW;
+    int position = snprintf(request, 4096,
+        "%s %s HTTP/1.1\r\nHost: 127.0.0.1:%s\r\nConnection: close\r\n"
+        "Content-Length: %zu\r\n", method, path, port, strlen(body));
+    size_t count = 0;
+    if (headers) for (const vela_header_t *h = headers; h->name; h++) {
+        if (++count > 24 || !vela_tls_once_field(h->name, true) ||
+            !vela_tls_once_field(h->value, false) || strchr(h->name, ':') ||
+            !strcasecmp(h->name, "Content-Length") ||
+            !strcasecmp(h->name, "Transfer-Encoding") ||
+            !strcasecmp(h->name, "Host") || !strcasecmp(h->name, "Connection"))
+            goto done;
+        int added = snprintf(request + position, 4096 - position,
+            "%s: %s\r\n", h->name, h->value);
+        if (added < 0 || added >= 4096 - position) {
+            ret = VELA_TLS_ERR_OVERFLOW;
+            goto done;
+        }
+        position += added;
+    }
+    if (position > 4093) { ret = VELA_TLS_ERR_OVERFLOW; goto done; }
+    memcpy(request + position, "\r\n", 3);
+    position += 2;
+    if (getaddrinfo("127.0.0.1", port, &hints, &address) != 0 || !address) {
+        ret = VELA_TLS_ERR_CONNECT;
+        goto done;
+    }
+    fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) { ret = VELA_TLS_ERR_CONNECT; goto done; }
+    struct timeval timeout = { .tv_sec = AGENT_LLM_SOCKET_TIMEOUT_SEC };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    if (connect(fd, address->ai_addr, address->ai_addrlen) < 0) {
+        ret = VELA_TLS_ERR_CONNECT;
+        goto done;
+    }
+    const char *parts[2] = { request, body };
+    size_t lengths[2] = { (size_t)position, strlen(body) };
+    for (size_t i = 0; i < 2; i++) {
+        size_t sent = 0;
+        while (sent < lengths[i]) {
+            ssize_t n = send(fd, parts[i] + sent, lengths[i] - sent, 0);
+            if (n <= 0) { ret = VELA_TLS_ERR_WRITE; goto done; }
+            sent += (size_t)n;
+        }
+    }
+    ret = vela_http_response_read(vela_tls_fixture_read, &fd, response_body,
+        response_capacity, response, event, event_context);
+done:
+    if (fd >= 0) close(fd);
+    if (address) freeaddrinfo(address);
+    free(request);
+    return ret;
+}

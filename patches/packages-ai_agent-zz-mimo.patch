+/* MiMo Chat exposes an on/off switch, not distinct reasoning intensities.
+ * Keep the requested level in configuration; send only the supported switch.
+ * Other providers must not receive MiMo-specific request fields.
+ */
+const char* llm_mimo_thinking_type(const char* host)
+{
+    if (strcmp(host, "api.xiaomimimo.com") != 0
+        && strcmp(host, "token-plan-cn.xiaomimimo.com") != 0
+        && strcmp(host, "token-plan-sgp.xiaomimimo.com") != 0
+        && strcmp(host, "token-plan-ams.xiaomimimo.com") != 0)
+        return NULL;
+    char level[16] = "enabled";
+    claw_config_get("mimo_thinking", level, sizeof(level));
+    return strcmp(level, "none") == 0 ? "disabled" : "enabled";
+}
+
+int llm_mimo_apply_options(cJSON* body, const char* host)
+{
+    const char* type = llm_mimo_thinking_type(host);
+    if (!type)
+        return OK;
+    cJSON* thinking = cJSON_AddObjectToObject(body, "thinking");
+    return thinking && cJSON_AddStringToObject(thinking, "type", type)
+        ? OK : ERROR;
+}

 int llm_chat(const char* system_prompt, const char* messages_json,
     char* response_buf, size_t buf_size);
 
+/* ── Local transport ──────────────────────────────────────── */
+
+/**
+ * A model that runs on the device itself is not reached over HTTPS.  The
+ * embedding application registers a transport for one backend host name;
+ * requests routed to that host are handed to it verbatim instead of being
+ * sent to the network, and everything around them -- routing, retries, tool
+ * parsing, usage accounting -- stays the code path the cloud backends use.
+ *
+ * The transport receives the OpenAI chat-completions request body and returns
+ * a heap-allocated chat-completions response body (freed by the caller) with
+ * the HTTP status it stands for.  Pass transport == NULL to unregister.
+ */
+typedef int (*llm_local_transport_t)(const char* request_json,
+    char** response_json, int* status, void* arg);
+
+int llm_set_local_transport(const char* host,
+    llm_local_transport_t transport, void* arg);
+
 /* ── Tool Use ─────────────────────────────────────────────── */
 

+/****************************************************************************
+ * Name: usbhost_audio_pending
+ ****************************************************************************/
+
+static bool usbhost_audio_pending(FAR struct usbhost_audio_stream_s *stream)
+{
+  irqstate_t flags;
+  bool pending;
+
+  flags = spin_lock_irqsave(&stream->queuelock);
+  pending = dq_peek(&stream->pendq) != NULL;
+  spin_unlock_irqrestore(&stream->queuelock, flags);
+  return pending;
+}

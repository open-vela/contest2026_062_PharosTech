config SYSTEM_CAMENC
        tristate "Camera to H.264 encoder"
        default n
        depends on KICKPI_K7_CAMERA && RK3576_VEPU_CODEC
        ---help---
                Take frames from the camera, encode them with the hardware
                encoder, and write the result as fragmented MP4.

                The chain is /dev/video0 for the camera, /dev/video1 for the
                encoder, and the muxer in camenc_stream.c. Fragmented MP4 is
                what a browser plays through Media Source Extensions, so the
                same conversion serves a file and, later, a network client.

                The muxer is deliberately separate from the loop around it: it
                has no file, no socket and no configuration, and takes a write
                callback. Lifting it into another application means copying one
                file and supplying a different destination.

if SYSTEM_CAMENC

config SYSTEM_CAMENC_PROGNAME
        string "Program name"
        default "camenc"

config SYSTEM_CAMENC_PRIORITY
        int "camenc task priority"
        default 100

config SYSTEM_CAMENC_STACKSIZE
        int "camenc stack size"
        default 8192

endif

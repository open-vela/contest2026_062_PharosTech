config EXAMPLES_NYAMPCTL
	tristate "Nyabula AMP control diagnostic"
	default n
	depends on RPMSG_CHAR
	---help---
		Build the nyampctl diagnostic for the Linux AMP compute domain:
		health, info, llm, blob and shmem commands.  It builds alone
		for the minimal AMP profile; when NYABULA_CORE_COMPUTE is also
		enabled it goes through that service, which then owns the
		endpoint.

if EXAMPLES_NYAMPCTL

config EXAMPLES_NYAMPCTL_PROGNAME
	string "Program name"
	default "nyampctl"

config EXAMPLES_NYAMPCTL_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_NYAMPCTL_STACKSIZE
	int "Task stack size"
	default 8192 if NYABULA_CORE_VOICE
	default 4096

endif

config SYSTEM_CAMCTL
	tristate "KICKPI-K7 camera capture tool"
	default n
	depends on KICKPI_K7_CAMERA
	---help---
		Capture frames from the MIPI CSI camera through /dev/video0 and
		report what arrived: frame count, sequence gaps, frame rate and a
		luma summary, with an option to write one frame out as NV12.

		It talks plain V4L2 through the NuttX capture framework, so it
		needs no knowledge of VICAP, the CSI HOST or the sensor.

if SYSTEM_CAMCTL

config SYSTEM_CAMCTL_PROGNAME
	string "Program name"
	default "camctl"

config SYSTEM_CAMCTL_PRIORITY
	int "camctl task priority"
	default 100

config SYSTEM_CAMCTL_STACKSIZE
	int "camctl stack size"
	default 8192

endif

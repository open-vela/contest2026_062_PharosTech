	default y
	depends on NYABULA_CORE_BT && BT_SETTINGS

config NYABULA_CORE_BT_A2DP_PREBUFFER_MS
	int "Music buffered before playback starts (ms)"
	default 200
	range 40 1000
	depends on NYABULA_CORE_BT
	---help---
		The cushion against radio jitter, which Wi-Fi traffic on the
		same chip makes worse.  It is also the delay behind the phone.

config NYABULA_CORE_BT_GATE_THRESHOLD

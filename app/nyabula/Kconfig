config NYABULA_EYE_ENGINE
	bool "Nyabula dual-eye engine"
	depends on GRAPHICS_LVGL && LIBCXX && LIBCXXABI && !BUILD_KERNEL
	select LV_USE_FLOAT
	select LV_USE_VECTOR_GRAPHIC
	select LV_USE_THORVG
	select LV_USE_CANVAS
	select NETUTILS_CJSON
	---help---
		Build the existing expression/scene engine as a library. A display
		owner attaches two LVGL roots and drains the bounded command queue.

if NYABULA_EYE_ENGINE

config NYABULA_EYE_DISPLAY
	bool "Nyabula Eye display owner application"
	default n
	depends on GRAPHICS_NYABULA_DISPLAY=y
	---help---
		Build the nyabula_eye product entry point. It calls the public
		Display API and owns Eye/LVGL updates without using the Display demo.

if NYABULA_EYE_DISPLAY

config NYABULA_EYE_PRIORITY
	int "Eye display task priority"
	default 100

config NYABULA_EYE_STACKSIZE
	int "Eye display task stack size"
	default 32768

endif

config CONTEST2026_062_NYABULA_DYNAMIC_FONTS
	bool "Load complete Eye fonts with FreeType"
	default n
	select LIB_FREETYPE
	select LV_USE_FREETYPE

config CONTEST2026_062_NYABULA_FONT_ROOT
	string "Complete Eye font directory"
	default "/data/nyabula/fonts"
	depends on CONTEST2026_062_NYABULA_DYNAMIC_FONTS

endif

config EXAMPLES_EYEPROBE
	bool "Headless Eye LCD sink (sim only)"
	default n
	depends on ARCH_SIM && LCD_DEV && !SIM_LCDDRIVER && !SIM_FRAMEBUFFER
	---help---
		Capture the two 360x360 RGB565 LCD pages for native Eye and
		Web mirror regressions. Never enabled in hardware firmware.

############################################################################
#
# Ethernet PHY drivers.  Compilation happens in nuttx/drivers/, so paths are
# relative to the `platform/` link.
#
############################################################################

ifeq ($(CONFIG_ETH_PHY_MAE0621A),y)
CSRCS += ethernet_phy.c mae0621a.c

DEPPATH += --dep-path platform$(DELIM)drivers$(DELIM)ethernet_phy
VPATH += :platform$(DELIM)drivers$(DELIM)ethernet_phy
endif

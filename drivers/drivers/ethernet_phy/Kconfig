#
# Ethernet PHY drivers: the part-specific half of a clause 22 driver.  The
# generic half -- the management bus, the address walk and the link state
# machine -- stays with the MAC, which is how the rest of the tree does it.  A
# board joins the two by putting these ops in its MAC configuration, so neither
# tree includes the other.
#
############################################################################

config ETH_PHY_MAE0621A
	bool "Maxio MAE0621A gigabit PHY"
	default n
	---help---
		Part-specific configuration for the Maxio MAE0621A: the vendor
		register pages, the link-down power saving pair that has to stay
		clear, the MDI pairing bits that only take effect across a reset,
		and an advertisement derived from the part's own capability
		registers rather than from a constant.

		The MAC driver still owns the management bus and the clause 22
		link poll; this only supplies the two hooks a board points its
		configuration at.

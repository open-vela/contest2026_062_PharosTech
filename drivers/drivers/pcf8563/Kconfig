#
# PCF8563 / HYM8563TS I2C real-time clock driver.
#
############################################################################

config RTC_PCF8563
    bool "PCF8563 / HYM8563TS RTC"
    default n
    select I2C
    select RTC_DATETIME
    select RTC_ALARM
    depends on RTC_EXTERNAL
    ---help---
        Enable the PCF8563 (and compatible HYM8563TS) I2C real-time
        clock/calendar driver.  The part provides 16 BCD-coded registers
        at fixed I2C 7-bit slave address 0x51.

        The alarm function is implemented and requires the PCF8563 INT pin
        to be wired to a board GPIO interrupt; the board routes that interrupt
        into pcf8563_alarm_service() (see kickpi_k7 boardinit).  If alarm
        support is not desired, set CONFIG_RTC_ALARM to n and the alarm code
        is compiled out (the driver then provides date/time only).

if RTC_PCF8563

config PCF8563_I2C_FREQUENCY
    int "PCF8563 I2C frequency"
    default 400000
    range 0 400000
    ---help---
        I2C bus frequency in Hz used to communicate with the PCF8563.

endif # RTC_PCF8563

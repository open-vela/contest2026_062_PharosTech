# OmniVision OV5647 MIPI CSI-2 camera sensor driver.
#
############################################################################

config VIDEO_OV5647
	bool "OV5647 camera sensor"
	default n
	depends on DRIVERS_VIDEO
	select I2C
	---help---
		Enable the OmniVision OV5647 MIPI CSI-2 camera sensor driver.

		The driver implements the NuttX capture framework's sensor side
		(struct imgsensor_s), so the board registers it together with a
		SoC-side imgdata driver:

		  ov5647_initialize(i2c, OV5647_I2C_ADDR);
		  capture_register("/dev/video0", imgdata, sensors, 1);

		The sensor outputs RAW10 Bayer data over two MIPI CSI-2 data
		lanes.  Its control interface is SCCB, which is an I2C subset the
		standard NuttX I2C driver drives directly.

		Two modes are implemented, selected by the choice below: 640x480
		(2x2 binned and subsampled) and 1296x960 (2x2 binned, full field of
		view, trimmed from the sensor's 1296x972 output to land on the
		encoder's macroblock grid).  The board and its VICAP/CSI
		configuration must agree with the mode chosen here; see the board's
		KICKPI_K7 camera source.

if VIDEO_OV5647

choice
	prompt "OV5647 capture mode"
	default OV5647_MODE_1296x960

config OV5647_MODE_640x480
	bool "640x480 (2x2 binned + subsampled, 60 fps)"
	---help---
		640x480 at 60 fps.  This is the original single mode: the sensor
		2x2-bins and then subsamples the full array down to VGA.  The link
		runs at 145.833 MHz and the vertical total is 504 lines, bounding
		the exposure to VTS-4 = 500 lines.

config OV5647_MODE_1296x960
	bool "1296x960 (2x2 binned, full field of view, ~30 fps)"
	---help---
		1296x960 at about 30 fps.  The sensor 2x2-bins the full array with
		no subsampling -- that yields 1296x972 -- and the bottom twelve rows
		are then trimmed so the height is a multiple of sixteen, which the
		encoder's macroblock grid and camenc's frame copy both require.  The
		result keeps the whole field of view and is sharper than the VGA
		mode.

		The link runs at 218.75 MHz and the vertical total is 1435 lines, so
		the exposure ceiling is VTS-4 = 1431 lines -- nearly three times the
		VGA mode's, which is what eases the 60 fps "exposure and gain pinned
		to their ceiling" problem.

endchoice

config OV5647_EXPOSURE_LINES
	int "Manual exposure in lines (0 = the mode's maximum)"
	default 0
	range 0 4095
	---help---
		The sensor's own exposure loop is switched off in favour of manual
		control, so the exposure has to be stated explicitly.  Zero keeps the
		mode's maximum, which is the right default for a bring-up where the
		lighting is unknown; a smaller value is what a bright scene or an
		auto-exposure experiment wants.

		Exposure is quoted in lines of the mode's line time, and the mode
		timebase is set by the HTS and VTS registers in the driver.

config OV5647_ANALOG_GAIN
	int "Manual analog gain (16 = 1.0x, 32 = 2.0x, 1023 = 64x)"
	default 32
	range 16 1023
	---help---
		The gain applied before the ADC.  With the exposure loop disabled
		this is the only other thing that decides how bright the picture
		comes out, so it doubles as the test for whether the light reaching
		the sensor is the limiting factor: raising it far above the default
		should brighten the picture proportionally, and if it does not, the
		gain setting is not reaching the sensor.

		The scale is sixteen to one, so the default of 32 is 2.0x.  High
		values amplify noise along with the signal, which is expected.

endif # VIDEO_OV5647

config OV5647_I2C_ADDR
	hex "OV5647 I2C (SCCB) slave address"
	default 0x36
	range 0x08 0x77
	depends on VIDEO_OV5647
	---help---
		Seven-bit SCCB address.  The OV5647's factory default is 0x36,
		which is what a Raspberry Pi compatible module uses.

config OV5647_I2C_FREQUENCY
	int "OV5647 I2C (SCCB) bus frequency"
	default 100000
	depends on VIDEO_OV5647
	---help---
		SCCB is specified for 100 kHz.  The sensor tolerates more on most
		modules, but the specification has no acknowledgement bit, so a
		faster clock leaves less margin for the receiver to sample it
		reliably.

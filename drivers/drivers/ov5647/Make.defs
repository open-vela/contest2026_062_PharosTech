############################################################################
#
# OV5647 MIPI CSI-2 camera sensor.  Compilation happens in nuttx/drivers/,
# so paths are relative to the `platform/` link.
#
############################################################################

ifeq ($(CONFIG_VIDEO_OV5647),y)
CSRCS += ov5647.c

DEPPATH += --dep-path platform$(DELIM)drivers$(DELIM)ov5647
VPATH += :platform$(DELIM)drivers$(DELIM)ov5647
endif

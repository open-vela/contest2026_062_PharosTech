############################################################################
# vendor/drivers/drivers/rk806/Kconfig
#
# RK806 PMIC regulator driver configuration.
#
# RK806 is the power management IC used on the kickpi-k7 (RK3576) board:
# a multi-channel PMIC providing several BUCK (DCDC) and LDO regulators,
# each independently switchable and voltage-adjustable.
############################################################################

config REGULATOR_RK806
    bool "RK806 PMIC regulator driver"
    default n
    depends on !DISABLE_MQUEUE
    select REGULATOR
    ---help---
        Enable support for the Rockchip RK806 PMIC, implemented on top of
        the NuttX regulator framework (include/nuttx/power/regulator.h).

        Each RK806 output (BUCK/LDO) is registered as a separate regulator
        device, exposed via the common regulator upper-half. Selecting this
        option compiles the driver.

if REGULATOR_RK806

menu "RK806 Regulator Output Configuration"

config RK806_BUCK1_NAME
    string "BUCK1 regulator name"
    default "rk806_buck1"
    ---help---
        Device name used when registering the RK806 BUCK1 regulator.
        Boards may override this to match their schematic net name
        (e.g. "vcc_1v8_s3").

config RK806_BUCK1_BOOT_ON
    bool "Enable BUCK1 at boot"
    default y

config RK806_BUCK1_ALWAYS_ON
    bool "Keep BUCK1 always on"
    default n

config RK806_BUCK1_SUPPLY
    string "BUCK1 input supply (VCC1) parent regulator name"
    default ""
    ---help---
        Name of the parent regulator that supplies BUCK1's input rail
        (VCC1).  Leave empty if VCC1 is a fixed/battery rail with no
        independently controlled parent regulator.

config RK806_BUCK2_NAME
    string "BUCK2 regulator name"
